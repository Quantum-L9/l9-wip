{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-communication:CommunicationExecutionPlan:0.1",
  "title": "CommunicationExecutionPlan",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "composition_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "composition_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "required_features_satisfied": {
      "type": "boolean"
    },
    "omitted_optional_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 40
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "plan_id",
    "operation_id",
    "scope_ref",
    "request_digest",
    "composition_ref",
    "composition_digest",
    "required_features_satisfied",
    "omitted_optional_features",
    "authorization_ref",
    "expires_at"
  ]
}
