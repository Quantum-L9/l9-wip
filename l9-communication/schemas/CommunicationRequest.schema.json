{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-communication:CommunicationRequest:0.1",
  "title": "CommunicationRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "target": {
      "$ref": "urn:l9:devpack:l9-communication:ChannelTarget:0.1"
    },
    "content": {
      "$ref": "urn:l9:devpack:l9-communication:SendContent:0.1"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 40
    },
    "optional_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 40
    },
    "execution_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "evidence_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "work_item_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "operation_id",
    "scope_ref",
    "purpose",
    "target",
    "content",
    "authorization_ref",
    "required_features",
    "optional_features",
    "execution_class",
    "deadline_ms",
    "evidence_policy_ref"
  ]
}
