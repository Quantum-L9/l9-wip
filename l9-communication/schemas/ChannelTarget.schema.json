{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-communication:ChannelTarget:0.1",
  "title": "ChannelTarget",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "channel_kind": {
      "enum": [
        "realtime",
        "telecom",
        "message",
        "email"
      ]
    },
    "account_binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "recipient_binding_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "native_thread_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "native_session_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "channel_kind",
    "account_binding_ref",
    "recipient_binding_ref"
  ]
}
