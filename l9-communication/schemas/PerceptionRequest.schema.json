{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-communication:PerceptionRequest:0.1",
  "title": "PerceptionRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modality": {
      "enum": [
        "image",
        "audio",
        "video",
        "document",
        "text"
      ]
    },
    "allowed_observation_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 20
    },
    "max_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000
    },
    "max_window_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300000
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    }
  },
  "required": [
    "operation_id",
    "scope_ref",
    "purpose",
    "input_ref",
    "input_digest",
    "modality",
    "allowed_observation_classes",
    "max_frames",
    "max_bytes",
    "max_window_ms",
    "authorization_ref",
    "evidence_policy_ref",
    "deadline_ms"
  ]
}
