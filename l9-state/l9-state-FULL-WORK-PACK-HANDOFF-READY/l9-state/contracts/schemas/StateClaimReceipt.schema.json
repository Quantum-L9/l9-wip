{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateClaimReceipt:1.0",
  "title": "StateClaimReceipt",
  "description": "Authoritative receipt for claim mutation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "enum": [
        "state.claim",
        "state.renew",
        "state.release"
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "enum": [
        "claimed",
        "renewed",
        "released",
        "refused",
        "conflict"
      ]
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "holder_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 32
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "contract_version",
    "receipt_id",
    "action",
    "operation_id",
    "request_digest",
    "scope_ref",
    "object_id",
    "principal_ref",
    "authorization_ref",
    "status",
    "issued_at",
    "reason_codes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "claimed",
              "renewed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "claim_id",
          "fencing_token",
          "holder_ref",
          "expires_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "required": [
          "claim_id",
          "fencing_token",
          "holder_ref",
          "released_at"
        ]
      }
    }
  ]
}
