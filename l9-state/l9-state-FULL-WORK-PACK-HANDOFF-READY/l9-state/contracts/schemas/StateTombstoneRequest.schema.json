{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateTombstoneRequest:1.0",
  "title": "StateTombstoneRequest",
  "description": "Revisioned tombstone without caller-supplied replacement payload.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "contract_version",
    "object_id",
    "scope_ref",
    "expected_revision",
    "expected_state_digest",
    "operation_id",
    "reason_code"
  ],
  "dependentRequired": {
    "claim_id": [
      "fencing_token"
    ],
    "fencing_token": [
      "claim_id"
    ]
  }
}
