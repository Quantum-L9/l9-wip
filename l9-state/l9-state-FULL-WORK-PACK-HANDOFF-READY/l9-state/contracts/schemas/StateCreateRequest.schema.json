{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateCreateRequest:1.0",
  "title": "StateCreateRequest",
  "description": "Create a never-used StateKey at revision 0.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 1000
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "retention_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retention_policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "contract_version",
    "object_id",
    "scope_ref",
    "schema_ref",
    "schema_digest",
    "payload",
    "operation_id",
    "retention_policy_ref",
    "retention_policy_digest"
  ]
}
