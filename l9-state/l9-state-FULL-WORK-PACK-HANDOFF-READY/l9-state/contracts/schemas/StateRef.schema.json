{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateRef:1.0",
  "title": "StateRef",
  "description": "Exact provider-neutral state identity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifecycle": {
      "enum": [
        "active",
        "tombstoned",
        "erased"
      ]
    }
  },
  "required": [
    "contract_version",
    "object_id",
    "scope_ref",
    "revision",
    "state_digest",
    "schema_ref",
    "schema_digest",
    "lifecycle"
  ]
}
