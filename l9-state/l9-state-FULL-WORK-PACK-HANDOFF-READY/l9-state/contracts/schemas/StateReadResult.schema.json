{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateReadResult:1.0",
  "title": "StateReadResult",
  "description": "Authorized state observation. Reads do not create durable operation receipts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "state_ref": {
      "$ref": "urn:l9:state:StateRef:1.0"
    },
    "payload_status": {
      "enum": [
        "present",
        "erased"
      ]
    },
    "payload": {
      "type": "object",
      "maxProperties": 1000
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_version",
    "state_ref",
    "payload_status",
    "recorded_at",
    "observed_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "payload_status": {
            "const": "present"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "payload_status": {
            "const": "erased"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "payload"
          ]
        }
      }
    }
  ]
}
