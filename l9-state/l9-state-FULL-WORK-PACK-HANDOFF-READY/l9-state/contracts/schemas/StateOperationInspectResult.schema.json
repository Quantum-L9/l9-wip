{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateOperationInspectResult:1.0",
  "title": "StateOperationInspectResult",
  "description": "Operation reconciliation result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "enum": [
        "found",
        "not_found"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "receipt": {
      "type": "object",
      "maxProperties": 100
    }
  },
  "required": [
    "contract_version",
    "scope_ref",
    "operation_id",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "found"
          }
        }
      },
      "then": {
        "required": [
          "request_digest",
          "receipt_schema_ref",
          "receipt"
        ]
      }
    }
  ]
}
