{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:state:StateReceipt:1.0",
  "title": "StateReceipt",
  "description": "Authoritative receipt for state payload/lifecycle mutations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "enum": [
        "state.create",
        "state.transition",
        "state.tombstone",
        "state.restore"
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "principal_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "enum": [
        "committed",
        "conflict",
        "refused"
      ]
    },
    "state_ref": {
      "$ref": "urn:l9:state:StateRef:1.0"
    },
    "event_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "maxItems": 32
    }
  },
  "required": [
    "contract_version",
    "receipt_id",
    "action",
    "operation_id",
    "request_digest",
    "scope_ref",
    "principal_ref",
    "authorization_ref",
    "status",
    "issued_at",
    "reason_codes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        }
      },
      "then": {
        "required": [
          "state_ref",
          "event_ref"
        ]
      }
    }
  ]
}
