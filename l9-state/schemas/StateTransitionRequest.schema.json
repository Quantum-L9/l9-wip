{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-state:StateTransitionRequest:0.1",
  "title": "StateTransitionRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_state_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 100
    },
    "transition_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "object_id",
    "scope_ref",
    "expected_revision",
    "expected_state_digest",
    "schema_ref",
    "schema_digest",
    "payload",
    "transition_label",
    "operation_id"
  ],
  "dependentRequired": {
    "claim_id": [
      "fencing_token"
    ],
    "fencing_token": [
      "claim_id"
    ]
  }
}
