{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-state:StateEventPage:0.1",
  "title": "StateEventPage",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "consumer_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "urn:l9:devpack:l9-state:StateTransitionEvent:0.1"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "coverage": {
      "enum": [
        "complete",
        "bounded",
        "resync_required"
      ]
    },
    "receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "scope_ref",
    "consumer_ref",
    "events",
    "coverage",
    "receipt_ref"
  ]
}
