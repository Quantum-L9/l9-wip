{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-state:StateReceipt:0.1",
  "title": "StateReceipt",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "committed",
        "duplicate",
        "conflict",
        "refused",
        "outcome_unknown"
      ]
    },
    "state_ref": {
      "$ref": "urn:l9:devpack:l9-state:StateRef:0.1"
    },
    "event_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "receipt_id",
    "operation_id",
    "request_digest",
    "status",
    "issued_at",
    "reason_codes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "committed",
              "duplicate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "state_ref",
          "event_ref"
        ]
      }
    }
  ]
}
