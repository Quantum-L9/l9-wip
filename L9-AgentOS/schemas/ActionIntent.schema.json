{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-agentos:ActionIntent:0.1",
  "title": "ActionIntent",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "work_item_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state_ref": {
      "$ref": "urn:l9:devpack:l9-state:StateRef:0.1"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability_action": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capability_contract_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "payload": {
      "type": "object",
      "maxProperties": 100
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 100
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "intent_id",
    "work_item_ref",
    "state_ref",
    "profile_digest",
    "capability_action",
    "capability_contract_ref",
    "scope_ref",
    "operation_id",
    "payload",
    "payload_digest",
    "evidence_refs",
    "expires_at",
    "budget_ref"
  ]
}
