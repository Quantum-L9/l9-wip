{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-agentos:ProfileContext:0.1",
  "title": "ProfileContext",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. Owner-local first-implementation profile section. More expressive policy vocabularies require versioned compiler admission; unknown keys fail closed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "required_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 100
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128000
          },
          "missing_required": {
            "const": "block"
          }
        },
        "required": [
          "id",
          "required_keys",
          "max_tokens",
          "missing_required"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "owner": {
      "const": "l9-context"
    }
  },
  "required": [
    "variants",
    "owner"
  ]
}
