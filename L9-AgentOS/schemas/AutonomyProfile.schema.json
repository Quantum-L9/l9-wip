{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-agentos:AutonomyProfile:0.1",
  "title": "AutonomyProfile",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. Owner-local first-implementation profile section. More expressive policy vocabularies require versioned compiler admission; unknown keys fail closed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default": {
      "const": "deny"
    },
    "external_effects": {
      "enum": [
        "disabled",
        "require_current_grants"
      ]
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "unknown_effect": {
      "const": "reconcile"
    }
  },
  "required": [
    "default",
    "external_effects",
    "max_rounds",
    "allow",
    "unknown_effect"
  ]
}
