{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-agentos:ProfileFragmentRef:0.1",
  "title": "ProfileFragmentRef",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "section": {
      "enum": [
        "identity",
        "objectives",
        "work_items",
        "observations",
        "state",
        "context",
        "memory",
        "autonomy",
        "capabilities",
        "interaction",
        "delegation",
        "projections",
        "governance"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "section",
    "path",
    "sha256"
  ]
}
