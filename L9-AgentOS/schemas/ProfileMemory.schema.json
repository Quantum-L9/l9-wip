{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-agentos:ProfileMemory:0.1",
  "title": "ProfileMemory",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. Owner-local first-implementation profile section. More expressive policy vocabularies require versioned compiler admission; unknown keys fail closed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "const": "l9-memory"
    },
    "candidate_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 30
    },
    "raw_transcript": {
      "const": "forbidden"
    },
    "scope": {
      "enum": [
        "manifestation_private",
        "explicit_shared_grant"
      ]
    },
    "consent": {
      "const": "owner_enforced"
    }
  },
  "required": [
    "owner",
    "candidate_classes",
    "raw_transcript",
    "scope",
    "consent"
  ]
}
