{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-evidence:EvidenceGetRequest:0.1",
  "title": "EvidenceGetRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "representation": {
      "enum": [
        "metadata",
        "bounded_text",
        "artifact_ref"
      ]
    }
  },
  "required": [
    "scope_ref",
    "evidence_ref",
    "purpose",
    "max_bytes",
    "representation"
  ]
}
