{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-ingest:DestinationOutcome:0.1",
  "title": "DestinationOutcome",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "destination": {
      "enum": [
        "evidence",
        "memory"
      ]
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pending",
        "admitted",
        "duplicate",
        "rejected",
        "quarantined",
        "outcome_unknown"
      ]
    },
    "receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 50
    }
  },
  "required": [
    "destination",
    "candidate_ref",
    "operation_id",
    "request_digest",
    "status",
    "reason_codes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "admitted",
              "duplicate"
            ]
          }
        }
      },
      "then": {
        "required": [
          "receipt_ref"
        ]
      }
    }
  ]
}
