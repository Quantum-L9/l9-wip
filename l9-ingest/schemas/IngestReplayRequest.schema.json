{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-ingest:IngestReplayRequest:0.1",
  "title": "IngestReplayRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ingestion_profile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "prior_operation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "view_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 20
    },
    "reason": {
      "type": "string",
      "maxLength": 16000
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "scope_ref",
    "source_evidence_ref",
    "ingestion_profile_ref",
    "profile_digest",
    "operation_id",
    "prior_operation_ref",
    "view_refs",
    "reason",
    "authority_ref"
  ]
}
