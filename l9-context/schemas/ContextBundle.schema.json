{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-context:ContextBundle:0.1",
  "title": "ContextBundle",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "need_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "required_coverage": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "unknown"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "urn:l9:devpack:l9-context:ContextItem:0.1"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 200
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 100
    },
    "retrieval_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 100
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "bundle_id",
    "bundle_digest",
    "need_ref",
    "scope_ref",
    "profile_digest",
    "plan_ref",
    "status",
    "required_coverage",
    "items",
    "omissions",
    "conflicts",
    "retrieval_receipt_refs",
    "issued_at",
    "expires_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "required_coverage": {
            "const": "satisfied"
          }
        }
      }
    }
  ]
}
