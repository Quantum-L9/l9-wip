{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-context:FormalFactBundle:0.1",
  "title": "FormalFactBundle",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "demand_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "demand_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vocabulary_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "urn:l9:devpack:l9-context:FormalFact:0.1"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "urn:l9:devpack:l9-context:PredicateCoverage:0.1"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "source_coordinates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 100
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "global_atomic_snapshot_claimed": {
      "const": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "bundle_id",
    "bundle_digest",
    "scope_ref",
    "demand_ref",
    "demand_digest",
    "vocabulary_digest",
    "status",
    "facts",
    "coverage",
    "source_coordinates",
    "exclusions",
    "global_atomic_snapshot_claimed",
    "issued_at",
    "expires_at"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "items": {
              "allOf": [
                {
                  "$ref": "urn:l9:devpack:l9-context:PredicateCoverage:0.1"
                },
                {
                  "properties": {
                    "status": {
                      "const": "complete"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
