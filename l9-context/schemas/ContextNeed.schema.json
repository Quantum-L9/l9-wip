{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-context:ContextNeed:0.1",
  "title": "ContextNeed",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Payload/semantic specimen; not a second transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "need_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "work_item_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state_ref": {
      "$ref": "urn:l9:devpack:l9-state:StateRef:0.1"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_profile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "required_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 100
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128000
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "expected_context_plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "need_id",
    "scope_ref",
    "work_item_ref",
    "state_ref",
    "profile_digest",
    "context_profile_ref",
    "purpose",
    "required_keys",
    "max_tokens",
    "max_bytes",
    "deadline_ms"
  ]
}
