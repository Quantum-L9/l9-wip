{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:l9:devpack:l9-context:FormalContextFulfillRequest:0.1",
  "title": "FormalContextFulfillRequest",
  "description": "PROPOSED_IMPLEMENTATION v0.1. Owner payload, not a transport envelope. ",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "demand_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "demand_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "urn:l9:devpack:l9-context:ExactFactRequirement:0.1"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "vocabulary_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "vocabulary_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000
    },
    "recursive_reasoning_allowed": {
      "const": false
    }
  },
  "required": [
    "operation_id",
    "scope_ref",
    "purpose",
    "demand_ref",
    "demand_digest",
    "requirements",
    "vocabulary_ref",
    "vocabulary_digest",
    "deadline_ms",
    "max_bytes",
    "recursive_reasoning_allowed"
  ]
}
